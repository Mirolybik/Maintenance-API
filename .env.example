PORT=3000
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000

# Параметры подключения к PostgreSQL (в Docker DB_HOST подменяется на db)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Аутентификация JWT. ОБЯЗАТЕЛЬНО замените значения на свои длинные случайные строки
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
