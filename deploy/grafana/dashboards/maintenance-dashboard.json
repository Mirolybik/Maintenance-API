          "format": "table",
          "rawSql": "SELECT e.name as \"Оборудование\", e.serial_number as \"Серийный №\", COUNT(r.id) as \"Всего заявок\", COUNT(CASE WHEN r.status = 'done' THEN 1 END) as \"Закрыто\", COALESCE(SUM(ra.hours), 0) as \"Трудозатраты (ч)\" FROM equipment e LEFT JOIN maintenance_requests r ON r.equipment_id = e.id LEFT JOIN request_assignees ra ON ra.request_id = r.id GROUP BY e.id, e.name, e.serial_number ORDER BY \"Всего заявок\" DESC;",
