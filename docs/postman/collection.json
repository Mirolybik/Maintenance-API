{
  "info": {
    "name": "Maintenance API (Кейс 4: аутентификация и RBAC)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Сначала выполните вход (Auth), токен сохраняется в переменную accessToken. Refresh-cookie Postman хранит сам."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "equipmentId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "technicianId",
      "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
    }
  ],
